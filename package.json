{
  "name": "echlub",
  "private": true,
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "wasm:build": "wasm-pack build crates/echlub-web --target web --out-dir pkg",
    "wasm:test": "wasm-pack test --node crates/echlub-web",
    "web:dev": "pnpm --filter @echlub/web dev",
    "web:typecheck": "pnpm --filter @echlub/web typecheck",
    "web:test": "pnpm --filter @echlub/web test",
    "web:build": "pnpm wasm:build && pnpm --filter @echlub/web build",
    "rust:fmt": "cargo fmt --all -- --check",
    "rust:clippy": "cargo clippy --workspace --all-targets --all-features -- -D warnings",
    "rust:test": "cargo test --workspace --all-features",
    "protocol:self-check": "cargo run -p echlub-protocol-lab --bin protocol-lab",
    "references:check": "python3 scripts/check-references.py",
    "performance:synthetic": "python3 scripts/run-performance-baseline.py",
    "performance:synthetic:validate": "python3 scripts/run-performance-baseline.py --validate-only",
    "performance:assess": "cargo run -p echlub-performance-report -- assess-synthetic",
    "performance:report": "cargo run -p echlub-performance-report -- summarize",
    "performance:live": "pnpm --filter @echlub/web dev",
    "performance:test": "cargo test -p echlub-performance && cargo test -p echlub-control-plane --test signaling",
    "performance:verify": "python3 scripts/run-performance-baseline.py --validate-only",
    "live:host": "python3 scripts/run-live-two-peer.py host",
    "live:peer": "python3 scripts/run-live-two-peer.py peer",
    "live:test": "cargo test -p echlub-performance && cargo test -p echlub-control-plane && corepack pnpm --filter @echlub/web test run",
    "live:e2e:single-host": "corepack pnpm --filter @echlub/live-dual-browser-harness e2e",
    "live:verify": "python3 scripts/run-live-two-peer.py verify && python3 scripts/check-references.py",
    "live:validate-endpoint": "cargo run -p echlub-performance-report -- validate-live-endpoint",
    "live:pair": "cargo run -p echlub-performance-report -- pair-live-endpoints",
    "verify": "python3 scripts/verify.py"
  }
}
